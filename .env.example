# Homebrew Postgres (no password, OS user):
DATABASE_URL="postgresql://localhost:5432/booking_system"
# Docker / hosted Postgres example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_system"

AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Seeded demo logins (created by `npx prisma db seed`)
# SYSTEM_OWNER: owner@demo.com / OwnerDemo123!
# BUSINESS_ADMIN (bright-smiles): admin@bright-smiles.demo / AdminDemo123!
# BUSINESS_ADMIN (northside-barbers): admin@northside.demo / AdminDemo123!
